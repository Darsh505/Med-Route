# .env.example — Med Route Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git!

# Database
DATABASE_URL=postgresql+asyncpg://medroute:password@localhost:5432/medroute
DATABASE_URL_SYNC=postgresql+psycopg2://medroute:password@localhost:5432/medroute
DB_PASSWORD=your_strong_password_here

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-immediately
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Geocoding
NOMINATIM_USER_AGENT=medroute-app/1.0

# Application
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]

# Data Pipeline
SEED_ON_STARTUP=true

# Next.js (Web Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Med Route
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_optional
